# Canonical site URL — used for metadata, Open Graph, sitemap and robots.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Public contact address shown in the footer and contact section.
# Leave unset to hide it (nothing is shown rather than a placeholder).
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles, comma-separated "Label|https://url" pairs. Unset = hidden.
# Only list profiles you actually post from — they also become schema.org sameAs.
# NEXT_PUBLIC_SOCIAL_LINKS=LinkedIn|https://www.linkedin.com/company/ruyalab,GitHub|https://github.com/...

# ---- Contact form email (recommended) ------------------------------------
# Server-only. With these set, each enquiry is emailed to CONTACT_TO_EMAIL
# (Reply-To = the visitor) and the visitor gets a short confirmation.
# RESEND_API_KEY must be a secret. The sender's domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@ruyalab.com
CONTACT_FROM_EMAIL="Ruyalab <contact@ruyalab.com>"

# Optional, server-only. Also POST each submission as JSON to a webhook.
# Works with Slack/Discord incoming webhooks, Zapier, Make, n8n or your own endpoint.
# With no email and no webhook configured: development logs submissions to
# the console; production shows an honest "form not accepting messages" error.
CONTACT_WEBHOOK_URL=

# ---- Studio CMS (/ruyashield) --------------------------------------------
# Server-only. Required to sign in at https://ruyalab.com/ruyashield
# Login is username + password, then a 6-digit authenticator code (TOTP).
# Generate TOTP with: node scripts/cms-totp-setup.mjs your-username
# CMS_ADMIN_USERNAME=your-username
# CMS_ADMIN_PASSWORD=use-a-long-random-password
# CMS_TOTP_SECRET=base32-secret-from-cms-totp-setup
# CMS_SESSION_SECRET=another-long-random-string-16plus
# Production also needs a D1 database bound as CMS_DB (see docs/cms.md).
